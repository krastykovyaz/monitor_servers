TG_BOT_TOKEN=
TG_CHAT_ID=
# optional: private key to use for all probes
SSH_KEY=
# optional: heartbeat receiver, see heartbeat_server.py
HB_URL=
# optional: name to report under (defaults to the host name)
HB_NAME=
# optional: a second bot (and chat, default: the same one) used when the main bot cannot deliver,
# e.g. its token was revoked or it was blocked. Also set both in /etc/monitor-heartbeat.env.
TG_FALLBACK_BOT_TOKEN=
TG_FALLBACK_CHAT_ID=
