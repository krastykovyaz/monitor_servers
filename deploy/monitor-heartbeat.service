[Unit]
Description=Monitoring heartbeat receiver (dead man's switch for the watchers)
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
StateDirectory=monitor-heartbeat
EnvironmentFile=/etc/monitor-heartbeat.env
ExecStart=/usr/bin/python3 /usr/local/lib/monitor-heartbeat/heartbeat_server.py
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=64M

[Install]
WantedBy=multi-user.target
