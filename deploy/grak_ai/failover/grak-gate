#!/bin/bash
# horek_ge: /usr/local/sbin/grak-gate
# Forced command for the lab's failover key (authorized_keys: command="/usr/local/sbin/grak-gate",restrict,...).
# The key can do exactly three things: renew the lease, read the status, and upload a state snapshot.
set -u
D=/var/lib/grak-failover
owner=$(cat "$D/owner" 2>/dev/null || echo lab)
case "${SSH_ORIGINAL_COMMAND:-}" in
  renew)
    if [ "$owner" = lab ]; then touch "$D/lease"; echo "owner=lab ok"; else echo "owner=$owner"; fi ;;
  status)
    echo "owner=$owner lease_age=$(( $(date +%s) - $(stat -c %Y "$D/lease" 2>/dev/null || echo 0) ))" ;;
  "rsync --server"*)
    [ "$owner" = lab ] || { echo "owner=$owner, upload refused" >&2; exit 1; }
    exec /usr/bin/rrsync -wo "$D/standby" ;;
  *)
    echo "not allowed" >&2; exit 1 ;;
esac
